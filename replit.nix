# Функция принимает набор пакетов Nixpkgs (стандартная библиотека пакетов Nix)
{pkgs}: {
  # Список зависимостей (пакетов), которые будут установлены в окружение Replit
  deps = [
    # lsof - утилита для просмотра открытых файлов и сетевых портов
    # Используется для диагностики: какие процессы заняли порт, устранения конфликтов
    # Пример: lsof -i :8000 показывает PID процесса на порту 8000
    pkgs.lsof
  ];
}